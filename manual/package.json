{
  "name": "amzdesk-manual",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Manuales de usuario y técnico de AMZ Desk",
  "scripts": {
    "start": "docusaurus start --port 3002",
    "start:tecnico": "cross-env DOCS_SITIO=tecnico docusaurus start --port 3003",
    "build": "pnpm run build:usuario && pnpm run build:tecnico",
    "build:usuario": "cross-env DOCS_SITIO=usuario docusaurus build --out-dir build/usuario",
    "build:tecnico": "cross-env DOCS_SITIO=tecnico docusaurus build --out-dir build/tecnico",
    "serve": "docusaurus serve --dir build/usuario --port 3002",
    "typecheck": "tsc",
    "capturas": "tsx scripts/capturas.ts"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@playwright/test": "^1.56.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
