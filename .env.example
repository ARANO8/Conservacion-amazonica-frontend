# Copia este archivo como .env.local para desarrollo.
#
# OJO: las variables NEXT_PUBLIC_* se hornean en el bundle del navegador
# durante `next build`. No se leen en runtime: cambiarlas exige reconstruir.

# URL base de la API.
#
#   Desarrollo: el backend corre aparte, en su propio puerto.
#   Produccion: la imagen Docker usa /amzdesk/api, porque el frontend comparte
#               dominio con la API detras del proxy.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Prefijo bajo el que se sirve la aplicacion.
#
#   Desarrollo: sin definir, la aplicacion vive en la raiz (http://localhost:3001).
#   Produccion: /amzdesk, porque el dominio aloja tambien otros sistemas.
#
# Debe empezar por "/" o quedar vacio: una cadena como "amzdesk" rompe el build.
NEXT_PUBLIC_BASE_PATH=
